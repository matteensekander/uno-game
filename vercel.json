{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/socket.io/(.*)", "dest": "server/index.js" },
    { "src": "/assets/(.*)", "dest": "client/dist/assets/$1" },
    { "src": "/(.*)", "dest": "client/dist/index.html" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
